+/// `RUSTC_LOCK_CONTENTION=<dir>`: the call sites (`#[track_caller]` locations) of `Lock::lock`
+/// that found the lock held, under the parallel front end (coverage of contention, mirth's
+/// docs/coverage-plan.md). Each site is written once per process to `<dir>/<pid>.locks`, with
+/// how many times it had been contended when the count reached a power of two.
+pub mod contention {
+    use std::io::Write;
+    use std::panic::Location;
+    use std::sync::{Mutex, OnceLock};
+
+    use crate::fx::FxHashMap;
+
+    static OUT: OnceLock<Option<std::path::PathBuf>> = OnceLock::new();
+    static SEEN: Mutex<Option<FxHashMap<(&'static str, u32, u32), u64>>> = Mutex::new(None);
+
+    #[inline]
+    pub fn enabled() -> bool {
+        OUT.get_or_init(|| std::env::var_os("RUSTC_LOCK_CONTENTION").map(Into::into)).is_some()
+    }
+
+    #[cold]
+    pub fn record(at: &'static Location<'static>) {
+        let Some(Some(dir)) = OUT.get() else { return };
+        let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+        let count = seen.get_or_insert_with(Default::default).entry((at.file(), at.line(), at.column())).or_insert(0);
+        *count += 1;
+        if !count.is_power_of_two() {
+            return;
+        }
+        let path = dir.join(format!("{}.locks", std::process::id()));
+        if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = writeln!(file, "{}\t{}\t{}\t{count}", at.file(), at.line(), at.column());
+        }
+    }
+}
