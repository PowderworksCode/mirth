+/// `RUSTC_PASS_EFFECT=<dir>`: which MIR passes changed a body (coverage of the passes, mirth's
+/// docs/coverage-plan.md). Each (pass, body kind, mir-opt-level, changed or not) is written once
+/// per process to `<dir>/<pid>.passes`, as it is first seen. Off without the variable.
+mod pass_effect {
+    use std::io::Write;
+    use std::sync::{Mutex, OnceLock};
+
+    use rustc_data_structures::fingerprint::Fingerprint;
+    use rustc_data_structures::fx::FxHashSet;
+    use rustc_data_structures::stable_hash::{StableHash, StableHasher};
+    use rustc_hir::def::DefKind;
+    use rustc_middle::mir::Body;
+    use rustc_middle::ty::{InstanceKind, TyCtxt};
+
+    static OUT: OnceLock<Option<std::path::PathBuf>> = OnceLock::new();
+    static SEEN: Mutex<Option<FxHashSet<(&'static str, &'static str, usize, bool)>>> = Mutex::new(None);
+
+    pub(super) fn enabled() -> bool {
+        OUT.get_or_init(|| std::env::var_os("RUSTC_PASS_EFFECT").map(Into::into)).is_some()
+    }
+
+    /// The body's blocks and locals, spans left out: what a pass changes.
+    pub(super) fn fingerprint<'tcx>(tcx: TyCtxt<'tcx>, body: &Body<'tcx>) -> Fingerprint {
+        tcx.with_stable_hashing_context(|mut hcx| {
+            let mut hasher = StableHasher::new();
+            hcx.while_hashing_spans(false, |hcx| {
+                body.basic_blocks.stable_hash(hcx, &mut hasher);
+                body.local_decls.stable_hash(hcx, &mut hasher);
+            });
+            hasher.finish()
+        })
+    }
+
+    pub(super) fn kind<'tcx>(tcx: TyCtxt<'tcx>, body: &Body<'tcx>) -> &'static str {
+        if body.source.promoted.is_some() {
+            return "promoted";
+        }
+        let InstanceKind::Item(def_id) = body.source.instance else { return "shim" };
+        match tcx.def_kind(def_id) {
+            DefKind::Fn | DefKind::AssocFn => "fn",
+            DefKind::Closure if tcx.is_coroutine(def_id) => "coroutine",
+            DefKind::Closure => "closure",
+            DefKind::Const { .. } | DefKind::AssocConst { .. } | DefKind::AnonConst => "const",
+            DefKind::Static { .. } => "static",
+            DefKind::Ctor(..) => "ctor",
+            _ => "other",
+        }
+    }
+
+    pub(super) fn record(pass: &'static str, kind: &'static str, level: usize, changed: bool) {
+        let Some(Some(dir)) = OUT.get() else { return };
+        let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+        if !seen.get_or_insert_with(Default::default).insert((pass, kind, level, changed)) {
+            return;
+        }
+        let path = dir.join(format!("{}.passes", std::process::id()));
+        if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = writeln!(file, "{pass}\t{kind}\t{level}\t{}", if changed { "changed" } else { "unchanged" });
+        }
+    }
+}
