+/// For testing incremental compilation (`rustc_data_structures::untracked`): the printing
+/// modes that are not at their defaults. Each is thread-local state set by the caller, so a
+/// query that starts with one set may compute a result that depends on who asked first.
+pub fn non_default_print_modes() -> Vec<&'static str> {
+    let mut out = Vec::new();
+    let flags: [(&'static str, &'static std::thread::LocalKey<Cell<bool>>); 8] = [
+        ("with_forced_impl_filename_line", &FORCE_IMPL_FILENAME_LINE),
+        ("with_crate_prefix", &SHOULD_PREFIX_WITH_CRATE),
+        ("with_resolve_crate_name", &SHOULD_PREFIX_WITH_CRATE_NAME),
+        ("with_no_trimmed_paths", &NO_TRIMMED_PATH),
+        ("with_forced_trimmed_paths", &FORCE_TRIMMED_PATH),
+        ("with_reduced_queries", &REDUCED_QUERIES),
+        ("with_no_visible_paths", &NO_VISIBLE_PATH),
+        ("with_no_visible_paths_if_doc_hidden", &NO_VISIBLE_PATH_IF_DOC_HIDDEN),
+    ];
+    for (name, flag) in flags {
+        if flag.get() {
+            out.push(name);
+        }
+    }
+    if !matches!(RTN_MODE.get(), RtnMode::ForDiagnostic) {
+        out.push("with_types_for_signature");
+    }
+    out
+}
