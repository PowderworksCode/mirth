+            for (fresh_id, loaded_id) in fresh_ids.into_iter().zip(loaded_ids) {
+                allocs.check(fresh_id, loaded_id, here);
+            }
+        }
+        if !(same_hash && same_text && same_bytes) {
+            let short = |s: &str| s.chars().take(2000).collect::<String>();
+            let what = [(same_hash, "stable hash"), (same_text, "Debug text"), (same_bytes, "encoding")]
+                .into_iter()
+                .filter_map(|(same, what)| (!same).then_some(what))
+                .collect::<Vec<_>>()
+                .join(", ");
+            eprintln!(
+                "rustc-verify-reuse: query `{}` for {:?}, green, differs from a fresh computation ({what})\n  reused: {}\n  fresh:  {}",
+                query.name,
+                key,
+                short(&loaded),
+                short(&computed),
+            );
+        }
+    }
+    let _ = std::fs::remove_file(&scratch);
+    if checked > 0 && std::env::var_os("RUSTC_VERIFY_REUSE").is_some_and(|v| v == "verbose") {
+        eprintln!("rustc-verify-reuse-checked: {} {checked}", query.name);
+    }
+}
